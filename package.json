{
  "name": "businessmode-demo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A standalone Next.js Todo demo integrating the BusinessMode SDK",
  "license": "MIT",
  "engines": {
    "node": "^24.0.0 || ^26.0.0"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@businessmode/sdk": "file:vendor/businessmode-sdk-0.1.0-preview.1.tgz",
    "next": "16.3.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@playwright/test": "1.55.1",
    "@types/node": "24.13.5",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.3",
    "tsx": "4.23.13",
    "typescript": "6.0.2"
  }
}
